# VibeCoder Model Configuration
# Use shortcodes (e.g., "deepseek", "gpt-4") or full model names

# Global Settings
DEFAULT_MODEL=deepseek
FALLBACK_MODEL=deepseek

# Available Shortcodes:
# deepseek -> deepseek/deepseek-r1-0528-qwen3-8b:free
